# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Matching AI provider. Use live_ai only after the Doubao Ark key is ready.
AI_MODE=fixture
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_API_KEY=
AI_MODEL=

# P1 only: fill after enabling vector retrieval
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Synthetic demo dataset
DEMO_DATASET_VERSION=v1
HOST=127.0.0.1
PORT=8787

# PostgreSQL. In Docker prefer DATABASE_PASSWORD_FILE over a plaintext URL.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=angelbridge
DATABASE_USER=angelbridge
DATABASE_PASSWORD_FILE=
# Production containers require PostgreSQL. Local fixture development may set false.
PERSISTENCE_REQUIRED=true

# Pet voice loop. Keep fixture until all Doubao services are enabled.
VOICE_MODE=fixture
DOUBAO_ARK_API_KEY=
DOUBAO_ARK_MODEL=doubao-seed-2-0-lite-260215
DOUBAO_SPEECH_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=
DOUBAO_TTS_STYLE=请用温柔、轻快、有陪伴感的语气说话。
