{
  "name": "angelbridge-backend-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx scripts/run-demo.ts",
    "demo:hybrid": "tsx scripts/run-hybrid-demo.ts",
    "api:dev": "tsx scripts/run-api.ts",
    "api:start": "tsx scripts/run-api.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "verify:fixtures": "tsx scripts/verify-fixtures.ts",
    "verify": "npm run typecheck && npm run test && npm run verify:fixtures"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
